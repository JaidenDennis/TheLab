# Copy to desk/brain/.env for local runs; set the same in Render for prod.
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Market data (falls back to NQ_DATABENTO_API_KEY from the repo .env)
DATABENTO_API_KEY=
# Tradovate — create the API key with ORDER PERMISSIONS DISABLED (read-only)
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=
# Must match desk-web's BRAIN_SHARED_SECRET
BRAIN_SHARED_SECRET=
# Where desk-web lives (for the fill pump's /api/rebuild calls)
WEB_URL=http://localhost:3000
